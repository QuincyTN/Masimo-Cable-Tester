uint8_t FAT_getWriteSecond(SD_FILE* finfo_p){
	// << 1 is similar to * 2
	// because the seconds number indicates the binary number of two-second
	// periods (0-29), representing seconds 0 to 58.
	return ((finfo_p->file_write_time) & 0x1F) << 1;
}
