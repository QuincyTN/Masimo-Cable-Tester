uint32_t parseHmiInt(char* string){
	//Return a 32 integer number in the format of NUM_MESSAGE
	return ((uint32_t)string[1]) | ((uint32_t)string[2]<<8) | ((uint32_t)string[3]<<16) | ((uint32_t)string[4]<<24);
}
